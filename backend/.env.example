# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VERIFY_SSL=false

# Environment
ENVIRONMENT=dev

# Database — use DB_-prefixed keys to avoid Windows env var shadowing
DB_HOSTNAME=your-sql-server-host
DB_PORT=1433
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_TRUST_SERVER_CERTIFICATE=yes
# Optional Qdrant hybrid schema retrieval
# Disabled by default; packaged DDL fallback remains available.
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=inrule_schema
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
DATAQUERY_SHADOW_ENABLED=false
